{
  "name": "@bricx/adapters",
  "version": "0.0.0",
  "private": true,
  "description": "The adapter registry (P6-04, ADR 0074): payment, tax, accounting, SMS and FX adapter descriptors, the Null adapters for development and tests, and the registry the API and the worker validate at boot. Server-only: apps/client may not import it.",
  "type": "module",
  "exports": {
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./null": {
      "types": "./src/null.ts",
      "default": "./src/null.ts"
    },
    "./registry": {
      "types": "./src/registry.ts",
      "default": "./src/registry.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bricx/tsconfig": "workspace:*",
    "@bricx/vitest-config": "workspace:*"
  },
  "dependencies": {
    "@bricx/domain": "workspace:*",
    "@bricx/money": "workspace:*",
    "@bricx/validation": "workspace:*"
  }
}
