{
  "name": "@bricx/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "The typed fetch client generated by orval from the API's OpenAPI document (P4-08, ADR 0058). Client-safe: no node:* at module load. TanStack Query hooks come at P7-01.",
  "type": "module",
  "exports": {
    "./fetcher": {
      "types": "./src/fetcher.ts",
      "default": "./src/fetcher.ts"
    },
    "./generated/*": {
      "types": "./src/generated/*.ts",
      "default": "./src/generated/*.ts"
    }
  },
  "scripts": {
    "gen": "orval --config ./orval.config.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bricx/validation": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bricx/tsconfig": "workspace:*",
    "@bricx/vitest-config": "workspace:*",
    "orval": "8.44.0"
  }
}
