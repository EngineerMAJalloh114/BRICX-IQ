  "components": {
    "schemas": {
      "CreateRole": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "permissions": {
            "maxItems": 192,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 72
            }
          }
        },
        "required": [
          "key",
          "name",
          "permissions"
        ],
        "additionalProperties": false
      },
      "DeviceList_Output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "platform": {
                  "type": "string",
                  "enum": [
                    "ios",
                    "android",
                    "web"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "createdAt": {
                  "type": "string"
                },
                "lastSeenAt": {
                  "type": "string"
                },
                "trusted": {
                  "type": "boolean"
                },
                "revokedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "platform",
                "name",
                "createdAt",
                "lastSeenAt",
                "trusted",
                "revokedAt"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "Device_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "platform": {
            "type": "string",
            "enum": [
              "ios",
              "android",
              "web"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "createdAt": {
            "type": "string"
          },
          "lastSeenAt": {
            "type": "string"
          },
          "trusted": {
            "type": "boolean"
          },
          "revokedAt": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "platform",
          "name",
          "createdAt",
          "lastSeenAt",
          "trusted",
          "revokedAt"
        ],
        "additionalProperties": false
      },
      "ErrorEnvelope": {
        "type": "object",
        "properties": {
          "status": {
            "type": "number"
          },
          "code": {
            "type": "string",
            "enum": [
              "validation_failed",
              "session_expired",
              "forbidden",
              "not_found",
              "conflict_financial",
              "rate_limited",
              "generic",
              "server_unavailable",
              "request.malformed",
              "request.body_too_large",
              "request.unsupported_media_type",
              "request.conflict",
              "idempotency.key_missing",
              "idempotency.key_invalid",
              "idempotency.key_reused",
              "idempotency.response_too_large",
              "unauthenticated"
            ]
          },
          "key": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    ]
                  }
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "required",
                    "invalid_value",
                    "unknown_field",
                    "too_large",
                    "invalid_email",
                    "invalid_phone",
                    "invalid_country",
                    "invalid_time_zone",
                    "invalid_language_tag",
                    "invalid_locale",
                    "invalid_geo_point",
                    "invalid_latitude",
                    "invalid_longitude",
                    "invalid_cursor",
                    "invalid_page_size",
                    "money.invalid_amount",
                    "money.amount_not_string",
                    "money.out_of_range",
                    "money.too_many_fraction_digits",
                    "money.invalid_currency",
                    "money.historical_currency",
                    "money.no_minor_unit",
                    "money.currency_mismatch",
                    "money.not_money",
                    "money.invalid_rounding",
                    "money.invalid_factor",
                    "money.factor_precision",
                    "money.invalid_rate",
                    "money.rate_precision",
                    "money.invalid_ratio",
                    "money.negative_ratio",
                    "money.ratios_sum_zero",
                    "money.no_ratios",
                    "money.invalid_locale"
                  ]
                },
                "key": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code",
                "key"
              ],
              "additionalProperties": false
            }
          },
          "truncated": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "status",
          "code",
          "key"
        ],
        "additionalProperties": false
      },
      "HealthReport": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "shutting_down"
            ]
          },
          "info": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": {}
            }
          },
          "error": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": {}
            }
          },
          "details": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "status",
          "details"
        ],
        "additionalProperties": false
      },
      "Money": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+$"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ],
        "additionalProperties": false
      },
      "RegisterDevice": {
        "type": "object",
        "properties": {
          "id": {
