{
  "name": "@bricx/db",
  "version": "0.0.0",
  "private": true,
  "description": "The database access layer: the only home of the Postgres pool (ADR 0040). P4-01 adds the readiness ping; P4-02 the Drizzle schema helpers and the migrator (ADR 0052); P4-03 withTx() (ADR 0053); P4-06 the transactional outbox and the relay's withRelayTx() (ADR 0056); P4-07 the idempotency-key store and TransactionCommitError (ADR 0057); P5-02 the error serializer of every service logger (ADR 0062).",
  "type": "module",
  "exports": {
    "./database": {
      "types": "./src/database.ts",
      "default": "./src/database.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "default": "./src/migrate.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./rls": {
      "types": "./src/rls.ts",
      "default": "./src/rls.ts"
    },
    "./outbox": {
      "types": "./src/outbox.ts",
      "default": "./src/outbox.ts"
    },
    "./idempotency": {
      "types": "./src/idempotency.ts",
      "default": "./src/idempotency.ts"
    },
    "./log": {
      "types": "./src/log.ts",
      "default": "./src/log.ts"
    }
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bricx/permissions": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@bricx/db-bootstrap": "workspace:*",
    "@bricx/tsconfig": "workspace:*",
    "@bricx/vitest-config": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}
