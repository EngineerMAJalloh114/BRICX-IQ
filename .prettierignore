# fail closed on them (ADR 0044).
scripts/guard-fixtures/dependabot/misindented-child.yml
scripts/guard-fixtures/dependabot/misindented-entry.yml
scripts/guard-fixtures/dependabot/tab.yml

# Generated by @bricx/i18n's scripts (ADR 0046): the generator owns the
# layout, and i18n:check compares src/generated/keys.ts byte for byte.
packages/i18n/src/generated/
packages/i18n/test/fixtures/check/**/src/generated/
# i18n:check fixture that is deliberately invalid JSON (ADR 0046).
packages/i18n/test/fixtures/check/invalid-json/locales/fr/errors.json

# Generated by @bricx/permissions' generators (ADR 0048): the generator owns
# the layout, and generate.test.ts compares generated/ byte for byte.
packages/permissions/generated/

