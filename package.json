{
  "name": "bricx-iq",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "verify": "turbo run typecheck lint test typecheck:root lint:root check:workspace format:check",
    "typecheck": "turbo run typecheck typecheck:root",
    "lint": "turbo run lint lint:root check:workspace",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:workspace": "node scripts/check-workspace-scripts.mjs",
    "check:turbo-cache": "node scripts/check-turbo-cache.mjs",
    "audit:prod": "node scripts/audit-prod.mjs",
    "lint:root": "eslint --max-warnings 0 commitlint.config.cjs eslint.config.mjs vitest.config.mts scripts infrastructure/docker/powersync/healthcheck.mjs",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "tools:gitleaks": "node scripts/install-gitleaks.mjs",
    "dev:up": "node scripts/dev-stack.mjs up",
    "dev:down": "node scripts/dev-stack.mjs down",
    "dev:reset": "node scripts/dev-stack.mjs reset"
  },
  "devDependencies": {
    "@bricx/eslint-config": "workspace:*",
    "@bricx/tsconfig": "workspace:*",
    "@bricx/vitest-config": "workspace:*",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
