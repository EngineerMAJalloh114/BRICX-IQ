{
  "name": "bricx-iq",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "verify": "turbo run typecheck lint test typecheck:root lint:root check:workspace format:check i18n:check",
    "typecheck": "turbo run typecheck typecheck:root",
    "lint": "turbo run lint lint:root check:workspace",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "i18n:check": "turbo run i18n:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:workspace": "node scripts/check-workspace-scripts.mjs",
    "check:turbo-cache": "node scripts/check-turbo-cache.mjs",
    "audit:prod": "node scripts/audit-prod.mjs",
    "audit:verify": "pnpm --filter @bricx/api build && node --env-file=.env --import ./apps/api/dist/register.js apps/api/dist/audit-verify.js",
    "membership:bootstrap": "pnpm --filter @bricx/api build && node --env-file=.env --import ./apps/api/dist/register.js apps/api/dist/membership-bootstrap.js",
    "lint:root": "eslint --max-warnings 0 commitlint.config.cjs eslint.config.mjs vitest.config.mts scripts infrastructure/docker/powersync/healthcheck.mjs",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "tools:gitleaks": "node scripts/install-gitleaks.mjs",
    "semgrep": "node scripts/semgrep.mjs --scan",
    "dev:up": "node scripts/dev-stack.mjs up",
    "dev:down": "node scripts/dev-stack.mjs down",
    "dev:reset": "node scripts/dev-stack.mjs reset",
    "dev:api": "pnpm --filter @bricx/api dev",
    "dev:worker": "pnpm --filter @bricx/worker dev",
    "db:migrate": "pnpm --filter @bricx/api build && node --env-file=.env --import ./apps/api/dist/register.js apps/api/dist/migrate.js",
    "db:rls": "node packages/db/scripts/rls.ts",
    "db:generate": "pnpm --filter @bricx/db generate",
    "new-module": "node scripts/new-module.mjs",
    "gen:api": "pnpm --filter @bricx/api openapi:emit && pnpm --filter @bricx/api-client gen"
  },
  "devDependencies": {
    "@bricx/eslint-config": "workspace:*",
    "@bricx/tsconfig": "workspace:*",
    "@bricx/vitest-config": "workspace:*",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
