{
  // Root files only (commitlint.config.cjs, eslint.config.mjs, vitest.config.mts, scripts/): type-checked so that
  // `lint:root` can use type information. Packages have their own tsconfig.
  "extends": "@bricx/tsconfig/node.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "commitlint.config.cjs",
    "eslint.config.mjs",
    "vitest.config.mts",
    "scripts"
  ]
}
