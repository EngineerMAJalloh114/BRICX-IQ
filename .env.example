# BRICX IQ local development environment (P2-01; P2-03 completes it).
# `pnpm dev:up` copies this file to .env (gitignored) when .env is missing,
# and appends any key added here later that .env lacks (never overwriting).
# Every credential below is an OBVIOUSLY FAKE local-only value. Never put a
# real credential in this file or in .env.

# Docker Compose reads these from the repo root, so plain `docker compose ...`
# commands run from the root target the dev stack.
COMPOSE_FILE=infrastructure/docker/compose.yml
COMPOSE_PROJECT_NAME=bricx-dev

# Postgres bootstrap superuser: used only by the postgres service's init
# scripts and healthcheck, never by application code or other services.
# The application DATABASE_URL arrives with P2-03.
POSTGRES_SUPERUSER_NAME=bricx_superuser
POSTGRES_SUPERUSER_PASSWORD=dev-only-postgres-superuser-password
POSTGRES_DATABASE=bricx_dev

# Database role passwords (P2-02, ADR 0035), set once when the postgres
# volume is first created: changing one later needs `pnpm dev:reset`.
BRICX_OWNER_PASSWORD=dev-only-bricx-owner-password
BRICX_APP_PASSWORD=dev-only-bricx-app-password
BRICX_READONLY_PASSWORD=dev-only-bricx-readonly-password
POWERSYNC_REPL_PASSWORD=dev-only-powersync-repl-password
POWERSYNC_STORAGE_PASSWORD=dev-only-powersync-storage-password

# PowerSync admin API token, used only by its healthcheck (loopback only).
POWERSYNC_API_TOKEN=dev-only-powersync-api-token

# Valkey (cache, queues, revocation list)
VALKEY_PASSWORD=dev-only-valkey-password

# S3-compatible storage (SeaweedFS locally; AWS S3 in production)
S3_ACCESS_KEY_ID=bricx-dev-access-key
S3_SECRET_ACCESS_KEY=dev-only-s3-secret-key
S3_BUCKET=bricx-dev

# Keycloak bootstrap admin (dev mode, placeholder realm until P5-01)
KEYCLOAK_ADMIN_USERNAME=bricx-dev-admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin-password
