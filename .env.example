# BRICX IQ local development environment (P2-01; P2-03 completes it).
# `pnpm dev:up` copies this file to .env (gitignored) when .env is missing,
# and appends any key added here later that .env lacks (never overwriting).
# Every credential below is an OBVIOUSLY FAKE local-only value. Never put a
# real credential in this file or in .env.

# Docker Compose reads these from the repo root, so plain `docker compose ...`
# commands run from the root target the dev stack.
COMPOSE_FILE=infrastructure/docker/compose.yml
COMPOSE_PROJECT_NAME=bricx-dev

# Postgres bootstrap superuser: used only by the postgres service's init
# scripts and healthcheck, never by application code or other services.
# Applications connect as bricx_app through DATABASE_URL (below).
POSTGRES_SUPERUSER_NAME=bricx_superuser
POSTGRES_SUPERUSER_PASSWORD=dev-only-postgres-superuser-password
POSTGRES_DATABASE=bricx_dev

# Database role passwords (P2-02, ADR 0035), set once when the postgres
# volume is first created: changing one later needs `pnpm dev:reset`.
BRICX_OWNER_PASSWORD=dev-only-bricx-owner-password
BRICX_APP_PASSWORD=dev-only-bricx-app-password
BRICX_READONLY_PASSWORD=dev-only-bricx-readonly-password
BRICX_RELAY_PASSWORD=dev-only-bricx-relay-password
POWERSYNC_REPL_PASSWORD=dev-only-powersync-repl-password
POWERSYNC_STORAGE_PASSWORD=dev-only-powersync-storage-password
# The global directory's roles (P6-01, ADR 0071), in database
# bricx_directory: migrations, the public resolve route, registration.
DIRECTORY_OWNER_PASSWORD=dev-only-directory-owner-password
DIRECTORY_READER_PASSWORD=dev-only-directory-reader-password
DIRECTORY_WRITER_PASSWORD=dev-only-directory-writer-password

# PowerSync admin API token, used only by its healthcheck (loopback only).
POWERSYNC_API_TOKEN=dev-only-powersync-api-token

# Valkey (cache, queues, revocation list)
VALKEY_PASSWORD=dev-only-valkey-password

# S3-compatible storage (SeaweedFS locally; AWS S3 in production)
S3_ACCESS_KEY_ID=bricx-dev-access-key
S3_SECRET_ACCESS_KEY=dev-only-s3-secret-key
S3_BUCKET=bricx-dev

# Keycloak bootstrap admin (dev stack only)
KEYCLOAK_ADMIN_USERNAME=bricx-dev-admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin-password
# The bricx realm's web redirect URI, origin and post-logout URI (P5-01,
# ADR 0060): read by the realm file's placeholders at import. localhost is a
# dev-only value (Expo web on 8081); each deployment sets its own.
KEYCLOAK_WEB_REDIRECT_URI=http://localhost:8081/auth/callback
KEYCLOAK_WEB_ORIGIN=http://localhost:8081
KEYCLOAK_WEB_LOGOUT_URI=http://localhost:8081/auth/logout
# The bricx-worker service account's client secret (P5-04, ADR 0060, ADR
# 0065): the realm file reads it at import, and the worker presents it for
# its admin token. Dev-only value; each deployment sets its own and rotates it.
KEYCLOAK_WORKER_CLIENT_SECRET=dev-only-keycloak-worker-client-secret

# --- Application config (@bricx/config, P2-03) ---
# Read by @bricx/config's loaders (api, worker, client-public, migrate;
# ADR 0039, 0052).
# Every key below is declared by one of its schemas, and every schema key
# is in this file (tested). The S3_* keys and KEYCLOAK_WORKER_CLIENT_SECRET
# above are shared with compose.
# Loaders never read this file: a dev entry point loads .env into the
# environment first. Production values come from the deployment's secret
# store, and production rejects any "dev-only" or "bricx-dev" value and a
# local database, cache or S3 host.
NODE_ENV=development
LOG_LEVEL=debug
# bricx_app (DML only, NOBYPASSRLS; ADR 0035). User, password and database
# must match BRICX_APP_PASSWORD and POSTGRES_DATABASE above (tested).
DATABASE_URL=postgres://bricx_app:dev-only-bricx-app-password@127.0.0.1:5432/bricx_dev
# bricx_owner, for `pnpm db:migrate` only (P4-02, ADR 0052): read by
# @bricx/config/migrate, never by the api or worker. User, password and
# database must match BRICX_OWNER_PASSWORD and POSTGRES_DATABASE above (tested).
MIGRATION_DATABASE_URL=postgres://bricx_owner:dev-only-bricx-owner-password@127.0.0.1:5432/bricx_dev
# bricx_relay, for the worker's outbox relay only (P4-06, ADR 0056): read by
# @bricx/config/worker, never by the api. User, password and database must
# match BRICX_RELAY_PASSWORD and POSTGRES_DATABASE above (tested).
RELAY_DATABASE_URL=postgres://bricx_relay:dev-only-bricx-relay-password@127.0.0.1:5432/bricx_dev
# The global directory (P6-01, ADR 0071), database bricx_directory. In
# development the API is both a cell and the directory. directory_reader
# (SELECT only), read by the api: set, it serves GET /v1/directory/resolve;
# unset, it is a cell only. User and password must match
# DIRECTORY_READER_PASSWORD above (tested).
DIRECTORY_DATABASE_URL=postgres://directory_reader:dev-only-directory-reader-password@127.0.0.1:5432/bricx_directory
# directory_owner, for `pnpm db:migrate` only: set, the migrator also runs the
# directory journal. Must match DIRECTORY_OWNER_PASSWORD above (tested).
DIRECTORY_MIGRATION_DATABASE_URL=postgres://directory_owner:dev-only-directory-owner-password@127.0.0.1:5432/bricx_directory
# directory_writer, read by the api (P6-02, ADR 0072): set, POST
# /v1/organizations reserves the slug here before the cell commits; unset,
# it answers 503. Must match DIRECTORY_WRITER_PASSWORD above (tested).
DIRECTORY_WRITER_DATABASE_URL=postgres://directory_writer:dev-only-directory-writer-password@127.0.0.1:5432/bricx_directory
# The cell this API serves (P6-02, ADR 0072): a directory.cells id; every
# organisation it creates records it as its data region. Development uses
# af-south-1 (db:migrate inserts both launch cells locally).
CELL_ID=af-south-1
# Row failures before the relay dead-letters an outbox row (1-100; unset: 10).
OUTBOX_DEAD_LETTER_AFTER=10
# Seconds a revocation key lives in Valkey (P5-04, ADR 0065): at least the
# realm's 300 s access token lifespan plus the API's 5 s clock tolerance
# (305-3600; unset: 330). The worker reads it, with KEYCLOAK_ISSUER (below)
# and KEYCLOAK_WORKER_CLIENT_SECRET (above).
REVOCATION_TTL_SECONDS=330
# Password must match VALKEY_PASSWORD above (tested).
VALKEY_URL=redis://default:dev-only-valkey-password@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# 4000, not 3000: Grafana (otel-lgtm) binds 127.0.0.1:3000.
API_PORT=4000
# Exact origins, comma separated (Expo web dev server).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# The Keycloak realm whose access tokens the API accepts (P5-02, ADR 0062):
# issuer, JWKS at <issuer>/protocol/openid-connect/certs, audience bricx-api.
# Production requires https and a remote host.
KEYCLOAK_ISSUER=http://localhost:8080/realms/bricx
# GET /openapi.json: public | authenticated | off (unset: public in
# development and test, off in production; public is refused in production).
OPENAPI_EXPOSURE=public
# Seconds between two last_seen_at writes for one user (0-86400; unset: 300).
USERS_LAST_SEEN_THROTTLE_SECONDS=300
# Most non-revoked devices one user may register (1-1000; unset: 20); the
# next POST /v1/devices is 409 until one is revoked (P5-03, ADR 0063).
DEVICES_MAX_PER_USER=20
# Temporary elevations (P5-06, ADR 0067): most open grants one user may hold
# per organisation (1-1000; unset: 20; the next POST /v1/access-grants is 409)
# and the longest grant window in seconds (60-2592000; unset: 86400 = 24 h).
ACCESS_GRANTS_MAX_PER_USER=20
ACCESS_GRANT_MAX_SECONDS=86400
# Most organisations one user may create, archived ones and unsettled
# attempts counted (1-1000; unset: 5); the next POST /v1/organizations is
# 409 (P6-02, ADR 0072).
ORGS_MAX_CREATED_PER_USER=5
# Invitations (P6-06, ADR 0077). Resends one invitation allows (1-20; unset:
# 5); the next is 409. The worker mints each token as <CELL_ID>.<secret>
# and mails the link <INVITE_LINK_BASE>/invite#<token> (an exact origin:
# the Expo web dev server here; production requires https and a remote
# host). MAILPIT_URL is the dev stack's Mailpit HTTP API, development only:
# production refuses it, and has no e-mail adapter until SES (P12).
# EMAIL_FROM is the From address (unset: no-reply@bricx.invalid).
INVITATION_MAX_RESENDS=5
INVITE_LINK_BASE=http://localhost:8081
MAILPIT_URL=http://127.0.0.1:8025
EMAIL_FROM=no-reply@bricx.invalid
# Rate limiting (P6-05d, ADR 0080; runbook docs/runbooks/rate-limiting.md).
# The proxies whose X-Forwarded-For the API believes: off (unset: off; the
# socket peer is the client), hops:N (1-3) or a CIDR list such as
# 10.0.0.0/16,10.1.0.0/16. "true" is refused; production refuses off.
# Deployed behind CloudFront then the ALB: hops:2.
TRUST_PROXY=off
# One override per limit class: ip, user and org limits per window (s),
# every field once. The values below are the defaults (estimates until the
# P14 load tests). The class ip limit applies only to @Public routes; every
# other route counts once against the default class's ip limit.
RATE_LIMIT_DEFAULT=ip=6000,user=600,org=30000,window=60
RATE_LIMIT_AUTH_ADJACENT=ip=30,user=20,org=600,window=600
RATE_LIMIT_INVITATION=ip=60,user=50,org=200,window=3600
RATE_LIMIT_UPLOAD=ip=120,user=60,org=1200,window=60
RATE_LIMIT_EXPORT=ip=30,user=10,org=100,window=3600
# Public: inlined into the client bundle. Never a secret.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
# The directory resolveCell() asks (P6-01): the dev API serves it (tested).
EXPO_PUBLIC_DIRECTORY_URL=http://127.0.0.1:4000
