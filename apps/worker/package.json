{
  "name": "@bricx/worker",
  "version": "0.0.0",
  "private": true,
  "description": "The background worker (plain Node, no Nest). P4-06: the transactional outbox relay (ADR 0056), publishing committed outbox rows to BullMQ on Valkey. P5-06 (ADR 0067): the access_grants.expire consumer and its 5-minute sweep.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file=../../.env --import ./dist/register.js dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "start": "node --import ./dist/register.js dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bricx/config": "workspace:*",
    "@bricx/db": "workspace:*",
    "@bricx/ids": "workspace:*",
    "@keycloak/keycloak-admin-client": "26.8.1",
    "bullmq": "6.3.15",
    "ioredis": "6.0.0",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@bricx/db-bootstrap": "workspace:*",
    "@bricx/keycloak-realm": "workspace:*",
    "@bricx/permissions": "workspace:*",
    "@bricx/tsconfig": "workspace:*",
    "@bricx/vitest-config": "workspace:*",
    "testcontainers": "12.2.1"
  }
}
