{
  // Type-checks the worker sources, the tests and the Vitest configs (no
  // emit). tsconfig.build.json compiles src/ to dist/.
  "extends": "@bricx/tsconfig/node.json",
  "compilerOptions": {
    // Types @bricx/vitest-config's JSDoc (an .mjs package) in the configs.
    "allowJs": true,
    // The live MFA test seeds @bricx/permissions' role bundles; that
    // client-safe package imports its own sources with .ts extensions
    // (ADR 0048), type-checked through the workspace link as apps/api and
    // packages/db do (P5-05). Nothing here is emitted by this config.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "test",
    "vitest.config.mts",
    "vitest.integration.config.mts"
  ]
}
