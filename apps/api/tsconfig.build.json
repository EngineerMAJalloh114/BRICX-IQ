{
  // Compiles src/ to dist/ (node --import ./dist/register.js dist/main.js).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Required with allowImportingTsExtensions when emitting; the api's own
    // sources import with .js, so nothing of its output changes.
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src"],
  // The module template is never built or registered (P4-09, ADR 0059):
  // pnpm new-module copies it; typecheck, lint and tests still cover it.
  "exclude": ["src/modules/_template"]
}
