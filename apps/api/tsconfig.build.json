{
  // Compiles src/ to dist/ (node --import ./dist/register.js dist/main.js).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Required with allowImportingTsExtensions when emitting; the api's own
    // sources import with .js, so nothing of its output changes.
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src"]
}
