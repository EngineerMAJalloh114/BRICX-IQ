{
  "name": "@bricx/api",
  "version": "0.0.0",
  "private": true,
  "description": "The NestJS API (modular monolith, Fastify adapter). P4-01: skeleton, health checks, logging, security headers, CORS, /v1 versioning. P4-03: request context, TxRunner, the request pool. P4-07: the problem+json error model and idempotency keys.",
  "type": "module",
  "scripts": {
    "audit:verify": "node --import ./dist/register.js dist/audit-verify.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file=../../.env --import ./dist/register.js dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "membership:bootstrap": "node --import ./dist/register.js dist/membership-bootstrap.js",
    "migrate": "node --import ./dist/register.js dist/migrate.js",
    "openapi:emit": "tsc -p tsconfig.build.json && node --import ./dist/register.js dist/openapi-emit.js",
    "start": "node --import ./dist/register.js dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@bricx/config": "workspace:*",
    "@bricx/db": "workspace:*",
    "@bricx/ids": "workspace:*",
    "@bricx/money": "workspace:*",
    "@bricx/permissions": "workspace:*",
    "@bricx/validation": "workspace:*",
    "@fastify/helmet": "13.2.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "canonicalize": "5.1.0",
    "drizzle-orm": "0.45.4",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bricx/db-bootstrap": "workspace:*",
    "@bricx/keycloak-realm": "workspace:*",
    "@bricx/tsconfig": "workspace:*",
    "@bricx/vitest-config": "workspace:*",
    "testcontainers": "12.2.1"
  }
}
