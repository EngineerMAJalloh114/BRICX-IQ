{
  "name": "@bricx/api",
  "version": "0.0.0",
  "private": true,
  "description": "The NestJS API (modular monolith, Fastify adapter). P4-01: skeleton, health checks, logging, security headers, CORS, /v1 versioning.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file=../../.env --import ./dist/register.js dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "migrate": "node --import ./dist/register.js dist/migrate.js",
    "start": "node --import ./dist/register.js dist/main.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@bricx/config": "workspace:*",
    "@bricx/db": "workspace:*",
    "@bricx/ids": "workspace:*",
    "@fastify/helmet": "13.1.2",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/terminus": "11.1.1",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@bricx/db-bootstrap": "workspace:*",
    "@bricx/tsconfig": "workspace:*",
    "@bricx/vitest-config": "workspace:*",
    "testcontainers": "12.2.0"
  }
}
